# Copy to .env.local and fill in. Never commit real values.

APP_URL=http://localhost:3000

# Adapter switches: keep "mock" until Google / Meta access is approved
GBP_PROVIDER=mock
MESSAGING_PROVIDER=mock

# Supabase (needed from M2) — project in ap-south-1 (Mumbai)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Local only (never in Vercel): used to apply migrations with `npx supabase db push --db-url`.
# Dashboard → Connect → Direct → Method: Session pooler → URI, with your database password filled in.
SUPABASE_DB_URL=

# Team "Continue with Google" on the login page — set to on after enabling Google in
# Supabase (see README → Google sign-in for the team)
NEXT_PUBLIC_GOOGLE_SIGNIN=

# Anthropic (needed from M5/M6)
ANTHROPIC_API_KEY=
# Optional per-task model overrides (defaults: posts/replies/report = claude-sonnet-5-5, audit = claude-opus-5-5)
# AI_MODEL_POSTS=
# AI_MODEL_REVIEW_REPLIES=
# AI_MODEL_AUDIT=
# AI_MODEL_REPORT_SUMMARY=

# Scheduled jobs (M7): any long random string. Set it in Vercel too; Vercel Cron sends it.
CRON_SECRET=

# WhatsApp Cloud API (M7) — only needed when MESSAGING_PROVIDER=meta (see README → Approvals)
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Optional: META_GRAPH_VERSION=v23.0, WA_TEMPLATE_APPROVAL=post_approval_request, WA_TEMPLATE_REMINDER=approval_reminder

# Email (owner connect invites). RESEND_API_KEY is the same key used for login emails.
# EMAIL_FROM must be on the verified domain, e.g. "GBP Pro <connect@sarvatraenergy.com>".
# Without these, invites are created as links you share yourself.
RESEND_API_KEY=
EMAIL_FROM=
